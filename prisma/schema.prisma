generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────
// USERS
// ─────────────────────────────────────────

model User {
  id                String    @id @default(cuid())
  email             String    @unique
  emailVerified     DateTime?
  password          String

  firstName         String
  lastName          String
  username          String    @unique
  nationality       String
  age               Int

  role              Role
  createdAt         DateTime  @default(now())

  affiliation       String?
  statement         String?

  verificationToken        String?
  verificationTokenExpires DateTime?

  resetToken        String?
  resetTokenExpires DateTime?

  // Relations
  orders            Order[]
  userExercises     UserExercise[]
}

enum Role {
  student
  instructor
  admin 
}

// ─────────────────────────────────────────
// CONTENT HIERARCHY
// ─────────────────────────────────────────

model Area {
  id          String   @id @default(cuid())
  name        String
  slug        String   @unique
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  topics      Topic[]
}

model Topic {
  id          String   @id @default(cuid())
  areaId      String
  name        String
  slug        String
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())

  area        Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)
  exercises   Exercise[]
  bundles     Bundle[]

  @@unique([areaId, slug])
}

// ─────────────────────────────────────────
// EXERCISES
// ─────────────────────────────────────────

model Exercise {
  id          String       @id @default(cuid())
  topicId     String
  title       String
  description String?
  type        ExerciseType
  content     Json         // questions, options, correct answers — flexible per type
  price       Decimal      @db.Decimal(8, 2)
  sortOrder   Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())

  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  bundleExercises BundleExercise[]
  orderItems      OrderItem[]
  userExercises   UserExercise[]
  attempts        ExerciseAttempt[]
  route  String?
}

enum ExerciseType {
  multiple_choice
  fill_in_the_blank
  translation
  matching
  true_false
  open_ended
}

// ─────────────────────────────────────────
// BUNDLES  (a set of exercises from one topic)
// ─────────────────────────────────────────

model Bundle {
  id        String   @id @default(cuid())
  topicId   String
  title     String
  price     Decimal  @db.Decimal(8, 2)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  topic           Topic            @relation(fields: [topicId], references: [id], onDelete: Cascade)
  bundleExercises BundleExercise[]
  orderItems      OrderItem[]
}

model BundleExercise {
  bundleId   String
  exerciseId String

  bundle     Bundle   @relation(fields: [bundleId], references: [id], onDelete: Cascade)
  exercise   Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)

  @@id([bundleId, exerciseId])
}

// ─────────────────────────────────────────
// ORDERS & STRIPE
// ─────────────────────────────────────────

model Order {
  id                   String      @id @default(cuid())
  userId               String
  stripeSessionId      String      @unique
  stripePaymentIntent  String?
  status               OrderStatus @default(pending)
  total                Decimal     @db.Decimal(8, 2)
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt

  user          User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  items         OrderItem[]
  userExercises UserExercise[]
}

enum OrderStatus {
  pending
  paid
  failed
  refunded
}

model OrderItem {
  id         String   @id @default(cuid())
  orderId    String
  exerciseId String?  // null when item is a bundle
  bundleId   String?  // null when item is a single exercise
  itemType   ItemType
  pricePaid  Decimal  @db.Decimal(8, 2)

  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  exercise   Exercise? @relation(fields: [exerciseId], references: [id])
  bundle     Bundle?   @relation(fields: [bundleId], references: [id])
}

enum ItemType {
  exercise
  bundle
}

// ─────────────────────────────────────────
// ACCESS CONTROL  (what the user has unlocked)
// ─────────────────────────────────────────

model UserExercise {
  id         String   @id @default(cuid())
  userId     String
  exerciseId String
  orderId    String
  unlockedAt DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  exercise Exercise @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
  order    Order    @relation(fields: [orderId], references: [id])
  attempts ExerciseAttempt[]

  @@unique([userId, exerciseId]) // a user can only unlock an exercise once
}

// ─────────────────────────────────────────
// PROGRESS TRACKING
// ─────────────────────────────────────────

model ExerciseAttempt {
  id             String   @id @default(cuid())
  userExerciseId String
  exerciseId     String
  answers        Json     // what the user submitted
  score          Int      // 0–100
  attemptedAt    DateTime @default(now())

  userExercise UserExercise @relation(fields: [userExerciseId], references: [id], onDelete: Cascade)
  exercise     Exercise     @relation(fields: [exerciseId], references: [id], onDelete: Cascade)
}
